@page "/demo/confirmpage"

<h3>Confirm Dialog Page</h3>
<Toasts class="p-3" Messages="messages" Placement="ToastsPlacement.TopRight" />
<ConfirmDialog @ref="dialog" yesButtonText="是" noButtonText="否" />

<Button Color="ButtonColor.Primary" @onclick="ShowConfirmAsync">Delete</Button>
<h4>@message</h4>

<hr />
<ConfirmDialog @ref="dialog2" />
<Button Color="ButtonColor.Danger" @onclick="DeleteMovieAsync">Delete Movie</Button>


@code {
    private ConfirmDialog dialog;
    private string message;

    private async Task ShowConfirmAsync()
    {
        var confirmation = await dialog.ShowAsync(
            title: "Are you sure you want to delete this?",
            message1: "This will permanently delete the item.",
            message2: "Do you want to proceed?",
            confirmDialogOptions: new ConfirmDialogOptions()
            {
                YesButtonText="是",
                NoButtonText="否"
            }
        );
        if (confirmation)
        {
            // Perform the delete action here
            Console.WriteLine("Item deleted.");
            message = "Item deleted.";
        }
        else
        {
            Console.WriteLine("Delete action canceled.");
            message = "Delete action canceled.";
        }
    }
}

@code 
{
    private ConfirmDialog dialog2;

    [Inject] ToastService ToastService { get; set; } = default!;
    List<ToastMessage> messages = new List<ToastMessage>();

    private async Task DeleteMovieAsync()
    {
        var parameters = new Dictionary<string, object>();
        parameters.Add("MovieId", 321);

        var options = new ConfirmDialogOptions()
            {
                YesButtonText = "是",
                YesButtonColor = ButtonColor.Success,
                NoButtonText = "否",
                NoButtonColor = ButtonColor.Danger,
                IsVerticallyCentered =true, // Dialog 是否顯示在螢幕正中央
                IsScrollable = true,
                AutoFocusYesButton = false
            };

        var confirmation = await dialog2.ShowAsync<MovieDemoComponent>("Are you sure you want to delete this movie?", parameters, options);

        if (confirmation)
        {
            // Perform the delete action here
            Console.WriteLine($"Movie deleted.");
            message = $"Movie deleted.";
            //messages.Add(new ToastMessage(ToastType.Success, message));
            ToastService.Notify(new ToastMessage(ToastType.Success, "", "刪除資料", "", message, autoHide: true));
        }
        else
        {
            Console.WriteLine("Delete action canceled.");
            message = "Delete action canceled.";
            // messages.Add(new ToastMessage(ToastType.Secondary, message));
            ToastService.Notify(new ToastMessage(ToastType.Secondary, "", "刪除資料", "", message, autoHide: true));
        }

    }


}
