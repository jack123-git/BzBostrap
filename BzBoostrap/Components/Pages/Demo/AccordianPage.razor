@page "/demo/accordian"
@rendermode InteractiveServer

<h3>AccordianPage</h3>

 @* AlwaysOpen="true" 讓各區塊顯示獨立，不受其他區塊影響 *@
 @* AlwaysOpen="false" 一次只會顯示一個區塊，展開一個區塊，原本展開區塊會關閉 *@
<Accordion AlwaysOpen="true">
    <AccordionItem Title="Accordion Item #1">
        <Content>
            <b>This is the first item's accordion body.</b>
            It is shown by default, until the collapse plugin add the app
        </Content>
    </AccordionItem>
    <AccordionItem Title="Accordion Item #2">
        <Content>
            <b>This is the third item's accordion body.</b>
            It is shown by default, until the collapse plugin add the app
        </Content>
    </AccordionItem>
    @* Title 加 Icon *@
    <AccordionItem>
        <TitleTemplate>
            <Icon Name="IconName.HouseFill" />Accordion Item #3
        </TitleTemplate>
        <Content>
            <b>This is the third item's accordion body.</b>
            It is shown by default, until the collapse plugin add the app
        </Content>
    </AccordionItem>

    @* Active="true" 該區塊一開始就會展開 *@
    <AccordionItem Active="true" Title="Accordion Item #4">
        <Content>
            <b>This is the second item's accordion body.</b>
            It is shown by default, until the collapse plugin add the app
        </Content>
    </AccordionItem>
    <AccordionItem Title="Accordion Item #5">
        <Content>
            <b>This is the third item's accordion body.</b>
            It is shown by default, until the collapse plugin add the app
        </Content>
    </AccordionItem>
</Accordion>

